# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-...
DOCSYNC_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DOCSYNC_FALLBACK_MODEL=openrouter/free
# Point at any OpenAI-compatible endpoint, e.g. NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub (read the code via GitHub MCP) ---
GITHUB_TOKEN=github_pat_...
DOCSYNC_REPO=your-user/your-repo
DOCSYNC_REF=main

# --- Notion (write docs via Notion MCP) ---
NOTION_TOKEN=ntn_...
NOTION_ROOT_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Slack (optional: post a summary after each run) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# --- Tuning ---
DOCSYNC_MAX_FILES=150
DOCSYNC_MAX_CONCURRENCY=3
DOCSYNC_REQUESTS_PER_SECOND=0.5
